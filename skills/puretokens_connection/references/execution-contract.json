{
  "$schema": "https://puretokensx.com/schemas/media-execution-contract.schema.json",
  "schemaVersion": 1,
  "kind": "connection",
  "transport": {
    "usesCurrentConfiguredConnection": true,
    "usesRelativePathsOnly": true,
    "doesNotInspectConnectionIdentity": true,
    "requiredHostCapabilities": ["authenticated_relative_http", "json_task_response"]
  },
  "operations": {
    "identity": { "method": "GET", "path": "/v1" }
  },
  "result": {
    "identitySource": "api_declared_public_health",
    "expectedStatus": "ok",
    "expectedName": "Pure Tokens API",
    "expectedBasePath": "/v1",
    "neverRetry": true,
    "doesNotExposeHostConfiguration": true,
    "unconfirmedDoesNotProveOtherService": true
  }
}
