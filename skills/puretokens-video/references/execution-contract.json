{
  "$schema": "https://puretokensx.com/schemas/media-execution-contract.schema.json",
  "schemaVersion": 1,
  "kind": "video",
  "transport": {
    "fixedApiOrigin": "https://api.puretokensx.com",
    "usesFullApiUrls": true,
    "usesRuntimeManagedAuthentication": true,
    "usesNarrowConfiguredCredentialResolver": true,
    "verifiedManagedRuntimeHosts": ["claude-code", "codex", "workbuddy", "gemini-cli", "grok-build", "opencode"],
    "neverExposesCredentialsOrHostConfiguration": true,
    "requiresNativeMediaByteDelivery": true,
    "doesNotUseMcpOrFallbackTransport": true,
    "workBuddyPostBodyTransport": "bounded_base64_argument_never_stdin"
  },
  "operations": {
    "catalog": { "method": "GET", "url": "https://api.puretokensx.com/v1/media/models" },
    "submit": {
      "method": "POST",
      "url": "https://api.puretokensx.com/v1/videos",
      "requiredBodyFields": ["model"],
      "conditionalBodyFields": {
        "prompt": "required_for_normal_text_generation_and_omitted_only_when_the_installed_or_on_demand_profile_declares_a_single-reference-exception",
        "all_other_user_optional_fields": "only_when_the_installed_exact_model_selection_or_an_on_demand_live_input_schema_declares_the_field_and_value"
      },
      "contentType": "profile_declared_json_or_multipart"
    },
    "edit": {
      "method": "POST",
      "url": "https://api.puretokensx.com/v1/videos/edits",
      "contentType": "multipart/form-data",
      "requiresDeclaredProfileOperation": "video_edit",
      "requiredBodyFields": ["model", "prompt", "video"],
      "inputSource": "current_user_explicit_native_media_only",
      "transport": "profile_declared_multipart_file"
    },
    "status": { "method": "GET", "urlTemplate": "https://api.puretokensx.com/v1/videos/{task_id}" },
    "content": { "method": "GET", "urlTemplate": "https://api.puretokensx.com/v1/videos/{task_id}/content" }
  },
  "result": {
    "successRequires": "native_video_bytes",
    "notSuccess": ["task_id", "status_text", "html", "svg", "component", "remote_url"],
    "sameTaskOnly": true,
    "neverAutoResubmit": true
  },
  "taskIdentity": {
    "receiptField": "task_id",
    "preferredResponseFieldSource": "installed_model_lifecycle_create_idField",
    "fallbackTopLevelResponseFields": ["task_id", "id"],
    "neverDerivesIdFromUrlsNestedObjectsOrPrompt": true,
    "pathEncoding": "percent_encode_opaque_id_as_one_path_segment",
    "whenMissing": "report_task_id_not_returned_and_do_not_poll_download_or_resubmit"
  },
  "taskState": {
    "declaredStateSource": "installed_model_lifecycle_poll",
    "reconciliationRequiredField": "reconciliation_required",
    "reconciliationPrecedesLifecycle": true,
    "whenReconciliationRequired": "stop_ordinary_polling_retain_same_task_id_do_not_submit_replacement_or_infer_refund",
    "fallbackPendingStates": ["pending", "queued", "running", "in_progress"],
    "fallbackSuccessStates": ["completed", "succeeded", "success"],
    "fallbackFailureStates": ["failed", "cancelled", "canceled", "expired", "error"],
    "whenUnrecognized": "report_raw_state_stop_automatic_polling_and_require_explicit_same_task_continuation"
  },
  "contentRetrieval": {
    "fetchOnlyAfterTerminalSuccess": true,
    "oneInFlightContentReadPerTask": true,
    "neverPrefetchOrRefetchDeliveredContent": true,
    "handoffBeforeNextContentRead": true
  },
  "parameterValidation": {
    "normalSubmissionUsesInstalledModelSelection": true,
    "exactModelCoreSubmissionDoesNotRequireCatalogPreflight": true,
    "onDemandLiveCatalogRead": "only_for_explicit_discovery_installed_profile_gap_or_post_rejection_diagnosis",
    "allModelsOptionalParametersRequire": "installed_model_selection_parameter_schema_or_on_demand_live_input_schema",
    "promptRequirementUsesInstalledOrOnDemandPropertiesAndConstraints": true,
    "resolutionUsesInstalledOrOnDemandModeConstraint": true,
    "whenProfileIsMissing": "do_not_submit_requested_optional_parameters_or_media_operations"
  },
  "inputMediaValidation": {
    "imageToVideoOperation": "image_to_video",
    "referenceImageVideoOperation": "reference_image_video",
    "referenceVideoOperation": "reference_video",
    "referenceAudioOperation": "reference_audio",
    "videoEditOperation": "video_edit",
    "requiresInstalledOrOnDemandProfileOperation": true,
    "publicUrlOrDeclaredIdReferenceRequires": "installed_model_selection_or_on_demand_live_profile_property_and_declared_reference_transport",
    "onlyCurrentUserExplicitMedia": true,
    "allowedTransports": ["multipart_file"],
    "skillPassesUserProvidedPublicUrlsOrDeclaredIdsWithoutDownloadingOrRehosting": true,
    "skillNeverDownloadsOrRehostsMedia": true,
    "gatewayStagesCurrentRequestAttachment": true,
    "nativeAttachmentRouteMustMatchDeclaredOperation": true,
    "nativeAttachmentMustNeverFallBackToJsonTextSubmission": true,
    "workBuddyNativeAttachmentBodyMode": "multipart_base64_descriptor_only",
    "whenCurrentAttachmentPathUnavailable": "stop_before_post_and_explain_declared_multipart_requirement",
    "multipleNativeAttachmentTypesRequireOneDeclaredCombinedOperation": true,
    "multiplePublicUrlOrIdFieldsRequireNoDeclaredConflict": true,
    "whenTransportUnavailable": "do_not_submit_and_explain_declared_transport"
  },
  "polling": {
    "serverDelay": "honor_valid_positive_retry_after_before_fallback",
    "serverDelayMustFitRemainingAutomaticDeadline": true,
    "afterHttp429": "honor_valid_positive_retry_after_then_continue_same_task_if_remaining_budget",
    "fallbackDelaysSeconds": [5, 10, 20, 40, 60],
    "steadyDelaySeconds": 60,
    "automaticDeadlineSeconds": 300,
    "maxAutomaticStatusReads": 7,
    "oneInFlightStatusReadPerTask": true,
    "automaticPollingScope": "submission_or_explicit_same_task_continuation_turn_only_no_background_timer_or_queue",
    "afterStatusReadError": "stop_on_5xx_transport_or_timeout_and_require_explicit_same_task_continuation",
    "explicitContinuation": "new_bounded_same_task_polling_window_only_when_explicitly_requested",
    "afterDeadline": "report_pending_and_require_explicit_same_task_continuation"
  },
  "submissionFailure": {
    "modelParameterOrCapabilityRejection": "one_on_demand_catalog_read_then_require_explicit_corrected_new_request",
    "rateLimit": "report_retry_after_when_returned_and_require_explicit_retry",
    "serverTransportOrTimeoutWithoutTaskId": "report_submission_outcome_unknown_without_declaring_task_absent_or_resubmitting",
    "runtimeInvocationOutputUnknown": "treat_submission_outcome_as_unknown_do_not_repeat_post_or_submit_replacement_task",
    "runtimeUnknownOutcomeResponse": "one_terminal_receipt_then_end_turn_without_followup_tool_status_or_poll_work",
    "noTaskIdLaterContinuation": "require_explicit_confirmation_of_a_new_billable_request_before_one_new_post"
  },
  "failureReceipt": {
    "requiredFields": ["failure_phase", "api_error_code", "http_status", "error_message", "next_action"],
    "allowedFailurePhases": ["validation", "submission", "status", "content"],
    "httpStatus": "numeric_when_returned_otherwise_not_returned",
    "apiErrorCode": "exact_explicit_public_api_error_code_otherwise_not_returned",
    "errorMessage": "safe_user_facing_summary_using_only_sanitized_public_api_detail_or_a_fixed_local_explanation",
    "retryAfterSeconds": "include_only_for_http_429_when_a_valid_positive_retry_after_is_returned",
    "forbiddenDisclosure": ["raw_response_body", "upstream_or_provider_identifier", "internal_hostname_or_url", "stack_trace", "request_headers", "request_body", "credentials_or_session_data", "user_reference_url_or_attachment_bytes"]
  },
  "unsupportedInput": ["undeclared_media_operation", "undeclared_combined_media_operation", "non_current_user_media"]
}
