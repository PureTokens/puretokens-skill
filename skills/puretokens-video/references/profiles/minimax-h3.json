{
  "$schema": "https://puretokensx.com/schemas/model-profile.schema.json",
  "schemaVersion": 1,
  "capability": "video",
  "catalogUpdatedAt": "2026-09-03",
  "catalogCapturedAt": "2026-09-03T04:00:37.535Z",
  "id": "minimax-h3",
  "parameterSchema": {
    "properties": {
      "prompt": {
        "type": "string",
        "required": true,
        "maxLength": 6000
      },
      "duration": {
        "type": "integer",
        "default": 15,
        "min": 4,
        "max": 15
      },
      "aspect_ratio": {
        "type": "string",
        "enum": [
          "21:9",
          "16:9",
          "4:3",
          "1:1",
          "3:4",
          "9:16"
        ],
        "default": "16:9"
      },
      "resolution": {
        "type": "string",
        "enum": [
          "720p",
          "2k",
          "4k"
        ]
      },
      "image_urls": {
        "type": "string[]"
      },
      "audio_urls": {
        "type": "string[]",
        "maxLength": 3
      }
    },
    "constraints": {
      "reference_transport": {
        "image_urls": [
          "public_https_url"
        ],
        "audio_urls": [
          "public_https_url"
        ]
      },
      "unsupported_inputs": {
        "reference_videos": [
          "not_supported"
        ]
      }
    },
    "lifecycle": {
      "create": {
        "successStatus": 200,
        "idField": "id",
        "object": "video",
        "initialStatuses": [
          "queued",
          "in_progress"
        ]
      },
      "poll": {
        "method": "GET",
        "path": "/v1/videos/{task_id}",
        "intervalSeconds": 5,
        "statusField": "status",
        "pendingStatuses": [
          "queued",
          "in_progress"
        ],
        "successStatuses": [
          "completed"
        ],
        "failureStatuses": [
          "failed"
        ],
        "resultFields": [
          "metadata.url"
        ]
      }
    },
    "operations": {
      "image_to_video": {
        "request": {
          "method": "POST",
          "path": "/v1/videos",
          "contentType": "multipart/form-data"
        },
        "requiredBodyFields": [
          "model",
          "prompt",
          "image"
        ],
        "inputs": {
          "image": {
            "field": "image",
            "required": true,
            "minItems": 1,
            "maxItems": 1,
            "transports": [
              "multipart_file"
            ]
          }
        }
      },
      "reference_image_video": {
        "request": {
          "method": "POST",
          "path": "/v1/videos",
          "contentType": "multipart/form-data"
        },
        "requiredBodyFields": [
          "model",
          "prompt",
          "reference_images"
        ],
        "inputs": {
          "reference_images": {
            "field": "reference_images",
            "required": true,
            "minItems": 1,
            "maxItems": 5,
            "transports": [
              "multipart_file"
            ]
          }
        }
      },
      "reference_audio": {
        "request": {
          "method": "POST",
          "path": "/v1/videos",
          "contentType": "multipart/form-data"
        },
        "requiredBodyFields": [
          "model",
          "prompt",
          "reference_audios"
        ],
        "inputs": {
          "reference_audios": {
            "field": "reference_audios",
            "required": true,
            "minItems": 1,
            "maxItems": 3,
            "transports": [
              "multipart_file"
            ]
          }
        }
      }
    }
  }
}
