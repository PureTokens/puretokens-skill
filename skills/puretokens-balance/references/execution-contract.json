{
  "$schema": "https://puretokensx.com/schemas/media-execution-contract.schema.json",
  "schemaVersion": 1,
  "kind": "balance",
  "transport": {
    "fixedApiOrigin": "https://console.puretokensx.com",
    "usesFullApiUrls": true,
    "usesManagedNativeExecutor": true,
    "usesCurrentHostConfiguredCredential": true,
    "credentialSourceNeverBecomesRequestTarget": true,
    "neverExposesCredentialsOrHostConfiguration": true,
    "doesNotUseNodeRuntime": true,
    "doesNotUseMcpOrFallbackTransport": true,
    "doesNotUseComputerUseOrUiAutomation": true,
    "doesNotInvokeOtherMediaSkillsAsApiFallback": true,
    "executionStart": "invoke_the_checksum_verified_managed_native_executor_with_the_current_host_id_and_fixed_request",
    "whenManagedNativeExecutorUnavailable": "report_only_an_actual_executor_network_credential_adapter_or_attachment_byte_failure_and_never_open_a_browser_desktop_ui_or_computer_use"
  },
  "operations": {
    "read": {
      "method": "GET",
      "url": "https://console.puretokensx.com/api/product/console/api-keys/usage",
      "requiresConfiguredApiKey": true,
      "requiresBrowserSession": false,
      "unitMetadataUrl": "https://console.puretokensx.com/api/product/console/status",
      "unitMetadataRequiresConfiguredApiKey": false,
      "maxRequests": 2,
      "deadlineSeconds": 30,
      "responseSchema": "https://puretokensx.com/schemas/balance-snapshot.schema.json"
    }
  },
  "result": {
    "reportOnlyReturnedFields": true,
    "neverEstimate": true,
    "neverRetry": true,
    "scopeRule": "unlimited_quota_true_account_wallet_else_key_allowance",
    "unit": "USD",
    "includesSubscriptionQuota": false,
    "calculation": "each_returned_quota_divided_by_public_quota_per_unit_in_USD_never_subtract_used_from_available",
    "fallbackWhenBalanceUnavailable": "report_actual_sanitized_failure_without_amount_and_guide_connection_settings_or_later_query",
    "defaultPresentation": "one_line_remaining_with_wallet_or_key_allowance_label",
    "legacyBillingFallbackAllowed": false
  }
}
