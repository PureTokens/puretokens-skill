{
  "$schema": "https://puretokensx.com/schemas/media-execution-contract.schema.json",
  "schemaVersion": 1,
  "kind": "balance",
  "transport": {
    "fixedApiOrigin": "https://api.puretokensx.com",
    "usesFullApiUrls": true,
    "usesRuntimeManagedAuthentication": true,
    "usesNarrowConfiguredCredentialResolver": true,
    "verifiedManagedRuntimeHosts": ["claude-code", "codex", "workbuddy", "gemini-cli", "grok-build", "opencode"],
    "neverExposesCredentialsOrHostConfiguration": true,
    "doesNotUseMcpOrFallbackTransport": true
  },
  "operations": {
    "read": {
      "method": "GET",
      "url": "https://api.puretokensx.com/api/product/desktop/account/balance",
      "requiresExistingAuthenticatedAccountSession": true,
      "responseSchema": "https://puretokensx.com/schemas/balance-snapshot.schema.json"
    }
  },
  "result": {
    "reportOnlyReturnedFields": true,
    "neverEstimate": true,
    "neverRetry": true,
    "fallbackWhenAccountSessionUnavailable": "report_direct_result_and_direct_to_puretokens_client_balance_view"
  }
}
