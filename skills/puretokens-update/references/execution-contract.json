{
  "$schema": "https://puretokensx.com/schemas/media-execution-contract.schema.json",
  "schemaVersion": 1,
  "kind": "update",
  "transport": {
    "localSkillManager": true,
    "usesOfficialMainBranch": true,
    "doesNotUseCustomInstallPayload": true,
    "doesNotReadCredentialsOrHostConfiguration": true,
    "requiresPinnedOfficialSourceRevision": true,
    "doesNotSubmitMediaOrUseMcp": true
  },
  "operations": {
    "sync": {
      "commandTemplate": "native_fetch install_or_update --host <current-supported-host>",
      "sourceRepository": "https://github.com/PureTokens/puretokens-skill.git",
      "sourceBranch": "main",
      "validationCommand": "pin_main_revision_verify_matching_platform_package_or_pinned_source_then_native_sync"
    },
    "init": {
      "commandTemplate": "native_executor init --host <current-supported-host>",
      "checks": "public_identity_then_one_authenticated_catalog_check_without_displaying_configuration",
      "usageGuide": "references/usage-guide.md"
    },
    "checkUpdate": {
      "commandTemplate": "native_fetch check-update --host <current-supported-host>",
      "checks": "pinned_official_version_and_managed_installed_version_without_sync_or_init"
    },
    "help": {
      "source": "references/usage-guide.md",
      "networkRequests": 0,
      "credentialReads": 0
    },
    "doctor": {
      "commandTemplate": "native_executor doctor --host <current-supported-host>",
      "checks": "known_local_skill_directories_versions_duplicates_then_existing_read_only_init",
      "doesNotRepair": true
    }
  },
  "result": {
    "installsMissingOfficialSkills": true,
    "upgradesOnlyManagedMatchingSkills": true,
    "neverOverwritesUnmanagedDirectories": true,
    "removesVerifiedRetiredManagedSkills": true,
    "removesVerifiedLegacyNodeRuntime": true,
    "installsChecksumVerifiedNativeApiExecutor": true,
    "reportsSynchronizedVersion": true,
    "removesLegacyCodexPluginWhenPresent": true,
    "requiresVerifiedRemovalWhenLegacyCodexPluginDetected": true,
    "doesNotClaimSuccessWithoutVersionReceipt": true,
    "neverModifiesOfficialCheckout": true,
    "requiresFullCodexRestartAfterLegacyPluginRemoval": true,
    "requiresNewHostConversationAfterSuccess": true,
    "helpOnlyDoesNotInvokeInit": true
  }
}
