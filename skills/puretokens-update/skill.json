{
  "schemaVersion": 1,
  "name": "puretokens-update",
  "version": "0.17.0",
  "entry": "SKILL.md",
  "displayName": "Pure Tokens Update",
  "description": "Install or safely upgrade local official Pure Tokens Skills.",
  "executionContract": "references/execution-contract.json",
  "behaviorScenarios": "references/behavior-scenarios.json",
  "usageGuide": "references/usage-guide.md",
  "distribution": {
    "codex": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/.agents/skills",
      "requiresPluginFeature": false
    },
    "claudeCode": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/.claude/skills"
    },
    "geminiCli": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/.gemini/skills"
    },
    "workbuddy": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/.workbuddy/skills"
    },
    "grokBuild": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/.grok/skills"
    },
    "opencode": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/.config/opencode/skills"
    },
    "trae": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/.trae/skills"
    }
  },
  "supportedClients": [
    "claude-code",
    "codex",
    "workbuddy",
    "gemini-cli",
    "grok-build",
    "opencode",
    "trae"
  ],
  "rules": {
    "usesOfficialMainBranch": true,
    "usesManagedSkillSync": true,
    "usesNativePlatformSourceSync": true,
    "doesNotUseCustomInstallPayload": true,
    "doesNotClaimSuccessWithoutVersionReceipt": true,
    "doesNotRequireNodeOrNpm": true,
    "installsMissingOfficialSkills": true,
    "neverOverwritesUnmanagedDirectories": true,
    "removesVerifiedRetiredSkills": true,
    "removesVerifiedLegacyNodeRuntime": true,
    "installsChecksumVerifiedNativeApiExecutor": true,
    "reportsSynchronizedVersion": true,
    "removesLegacyCodexPluginWhenPresent": true,
    "requiresPreflightValidation": true,
    "doesNotReadCredentialsOrHostConfiguration": true,
    "doesNotUseMcpOrFallbackTransport": true,
    "requiresNewHostConversationAfterUpdate": true,
    "usageOnlyDoesNotAccessNetwork": true,
    "requiresPinnedOfficialSourceRevision": true,
    "supportsReadOnlyUpdateCheck": true,
    "supportsReadOnlyDoctor": true,
    "doesNotSubmitMediaOrReadBilling": true
  },
  "sourceSha256": "0fcacb33888bafd35c10c77e6d2a9427abe534a3d6f5c004d258104a1f2e4d9b"
}
