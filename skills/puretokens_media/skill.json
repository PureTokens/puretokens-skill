{
  "schemaVersion": 1,
  "name": "puretokens_media",
  "version": "0.2.7",
  "entry": "SKILL.md",
  "displayName": "Pure Tokens Media",
  "description": "Check a read-only Pure Tokens balance snapshot, or handle a Pure Tokens image or video request.",
  "mcp": {
    "server": "puretokens-image",
    "tools": [
      "puretokens_get_balance",
      "puretokens_get_model_price",
      "puretokens_list_media_models",
      "puretokens_generate_image",
      "puretokens_image_result",
      "puretokens_generate_video",
      "puretokens_video_result"
    ]
  },
  "behaviorTests": "skills/puretokens_media/references/behavior-scenarios.json",
  "naturalLanguageAliases": "skills/puretokens_media/references/natural-language-aliases.json",
  "distribution": {
    "claudeDesktop": {
      "format": "zip",
      "archiveRoot": "puretokens_media",
      "requiredFiles": [
        "SKILL.md",
        "skill.json"
      ],
      "importPath": "Settings > Features > Skills > Upload skill",
      "enableAfterImport": true
    }
  },
  "supportedClients": [
    "claude-code",
    "claude-desktop",
    "codex",
    "workbuddy",
    "gemini-cli",
    "grok-build",
    "opencode"
  ],
  "excludedClients": [
    "trae"
  ],
  "rules": {
    "requiresExactModelId": true,
    "naturalLanguageResolutionBelongsToSkill": true,
    "usesCuratedNaturalLanguageAliasRegistry": true,
    "usesDeterministicMediaDefaults": true,
    "balanceUsesReadOnlySnapshot": true,
    "neverGuessModelOrProtocol": true,
    "neverResubmitPendingTask": true,
    "stableRequestIdRequired": true,
    "reuseRequestIdOnHostRetry": true,
    "neverAutoResubmitAfterError": true,
    "neverAutoSwitchModelAfterError": true,
    "successRequiresNativeMediaResult": true,
    "completedMediaRequiresLocalFileDelivery": true,
    "completedImageRequiresNativeImageContent": true,
    "completedMediaReportsExactModel": true,
    "completedMediaReportsLocalDelivery": true,
    "completedVideoUsesBoundedNativeResource": true
  }
}
