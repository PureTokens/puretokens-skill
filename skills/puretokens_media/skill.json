{
  "schemaVersion": 1,
  "name": "puretokens_media",
  "version": "0.4.15",
  "entry": "SKILL.md",
  "displayName": "Pure Tokens Media",
  "description": "Resolve and handle a Pure Tokens image or video request.",
  "mcp": {
    "server": "puretokens-image",
    "tools": [
      "puretokens_list_media_models",
      "puretokens_generate_image",
      "puretokens_image_result",
      "puretokens_generate_video",
      "puretokens_video_result"
    ]
  },
  "behaviorTests": "skills/puretokens_media/references/behavior-scenarios.json",
  "naturalLanguageAliases": "skills/puretokens_media/references/natural-language-aliases.json",
  "directCloudContract": "skills/puretokens_media/references/direct-cloud-contract.md",
  "workBuddyAdapter": "skills/puretokens_media/adapters/workbuddy-execution.md",
  "distribution": {
    "claudeDesktop": {
      "format": "zip",
      "archiveRoot": "puretokens_media",
      "requiredFiles": [
        "SKILL.md",
        "skill.json"
      ],
      "importPath": "Settings > Features > Skills > Upload skill",
      "enableAfterImport": true
    },
    "workbuddy": {
      "managedByDesktop": true,
      "manualInstallationSupported": true,
      "generatedSkillName": "puretokens_workbuddy_router",
      "alwaysApply": true,
      "preservesExplicitHostModelChoice": true
    },
    "codex": {
      "managedByDesktop": true,
      "manualInstallationSupported": true,
      "managedSkillDirectory": "~/.codex/skills/puretokens_media",
      "requiresPluginFeature": false,
      "supportsDirectCloud": true,
      "managedMcpWhenDesktopAvailable": true
    }
  },
  "supportedClients": [
    "claude-code",
    "claude-desktop",
    "codex",
    "workbuddy",
    "gemini-cli",
    "opencode"
  ],
  "excludedClients": [
    "trae"
  ],
  "rules": {
    "requiresExactModelId": true,
    "liveCatalogDefinesSupportedModels": true,
    "registeredAliasesAreConvenienceOnly": true,
    "naturalLanguageResolutionBelongsToSkill": true,
    "usesCuratedNaturalLanguageAliasRegistry": true,
    "usesDeterministicMediaDefaults": true,
    "defaultResultCount": 1,
    "explicitCountRequiredForMultipleResults": true,
    "neverGuessModelOrProtocol": true,
    "neverResubmitPendingTask": true,
    "stableRequestIdRequired": true,
    "reuseRequestIdOnHostRetry": true,
    "neverAutoResubmitAfterError": true,
    "neverAutoSwitchModelAfterError": true,
    "successRequiresNativeMediaResult": true,
    "completedMediaRequiresLocalFileDelivery": true,
    "completedImageRequiresNativeImageContent": true,
    "image2ReturnsNativeImageWithoutResultPolling": true,
    "completedMediaReportsExactModel": true,
    "completedMediaReportsLocalDelivery": true,
    "completedVideoUsesBoundedNativeResource": true,
    "supportsDirectCloudWithoutDesktop": true,
    "supportsSkillDefinedImage2Api": true,
    "supportsSkillDefinedConnectionVideoApi": true,
    "supportsCatalogVerifiedConnectionImageApi": true,
    "connectionImageApiRequiresHostExecutionAndDelivery": true,
    "connectionImageFallbackIsDisclosedBeforeSubmission": true,
    "supportsPureTokensOnly": true,
    "nonPureTokensConnectionFailsClosed": true,
    "physicalImageDimensionsFailClosed": true,
    "supportedImageCanvasesAreExplicit": true,
    "desktopManagedDeliveryIsOptional": true,
    "preservesExplicitHostModelChoice": true,
    "supportsVerifiedHostNativeMediaExecution": true,
    "hostNativeExecutionRequiresVerifiedMediaCapability": true,
    "hostNativeExecutionAvoidsDuplicateSubmission": true,
    "directCloudRequiresHostInjectedCredentials": true,
    "directCloudUsesExplicitGatewayEndpointCapabilities": true,
    "directCloudImagesAlwaysAsync": true,
    "directCloudRequiresDeliveryCapability": true,
    "directCloudUsesZeroBasedContentIndexForMultipleImages": true,
    "directCloudDeliversSynchronousImageBytes": true,
    "directCloudDeliversAsyncContentBytes": true
  }
}
