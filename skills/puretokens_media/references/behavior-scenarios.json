{
  "schemaVersion": 1,
  "skill": "puretokens_media",
  "scenarios": [
    {
      "id": "default-single-result",
      "when": "The user asks for an image or video without an explicit quantity.",
      "expected": "request_exactly_one_result_in_one_logical_task",
      "forbiddenTools": ["additional_generation_submission"]
    },
    {
      "id": "explicit-multiple-results",
      "when": "The user explicitly requests more than one image result.",
      "expected": "pass_the_explicit_count_once_when_supported_or_report_unsupported",
      "forbiddenTools": ["additional_generation_submission", "automatic_resubmission"]
    },
    {
      "id": "direct-cloud-image-delivery",
      "when": "A Direct Cloud image response returns data[].b64_json, data[].url, or an asynchronous task.",
      "expected": "write_actual_image_bytes_before_reporting_success",
      "forbiddenTools": ["upstream_url_as_delivery", "automatic_resubmission"]
    },
    {
      "id": "ambiguous-model",
      "when": "The requested display name, alias, provider, or media type matches more than one catalog model.",
      "firstTool": "puretokens_list_media_models",
      "expected": "ask_user_to_choose",
      "forbiddenTools": ["puretokens_generate_image", "puretokens_generate_video"]
    },
    {
      "id": "no-media-model",
      "when": "The catalog is empty or has no model with the requested capability.",
      "firstTool": "puretokens_list_media_models",
      "expected": "report_no_available_model",
      "forbiddenTools": ["puretokens_generate_image", "puretokens_generate_video"]
    },
    {
      "id": "mcp-unavailable",
      "when": "The puretokens-image MCP server cannot be listed or called.",
      "firstTool": "puretokens_list_media_models",
      "expected": "tell_user_to_configure_and_restart_client",
      "forbiddenTools": ["puretokens_generate_image", "puretokens_generate_video"]
    },
    {
      "id": "task-failure",
      "when": "A generation or result tool returns an error, including safeToResubmit=false.",
      "firstTool": "selected_generation_or_result_tool",
      "expected": "report_error_without_fallback_or_resubmit",
      "forbiddenTools": ["automatic_model_switch", "automatic_resubmission"]
    },
    {
      "id": "task-timeout",
      "when": "The matching result tool does not return a native media resource before its polling window ends.",
      "firstTool": "selected_result_tool",
      "expected": "report_pending_or_unknown_without_resubmit",
      "forbiddenTools": ["automatic_model_switch", "automatic_resubmission"]
    },
    {
      "id": "content-delivery-failure",
      "when": "A completed task is missing content bytes or local delivery fails.",
      "firstTool": "selected_result_or_content_endpoint",
      "expected": "report_failed_or_unknown_without_success_claim",
      "forbiddenTools": ["automatic_model_switch", "automatic_resubmission"]
    }
  ]
}
