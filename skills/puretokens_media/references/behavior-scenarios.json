{
  "schemaVersion": 1,
  "skill": "puretokens_media",
  "scenarios": [
    {
      "id": "default-single-result",
      "when": "The user asks for an image or video without an explicit quantity.",
      "expected": "request_exactly_one_result_in_one_logical_task",
      "forbiddenTools": ["additional_generation_submission"]
    },
    {
      "id": "explicit-multiple-results",
      "when": "The user explicitly requests more than one image result.",
      "expected": "pass_the_explicit_count_once_when_supported_or_report_unsupported",
      "forbiddenTools": ["additional_generation_submission", "automatic_resubmission"]
    },
    {
      "id": "invalid-image-count",
      "when": "The user requests zero, a negative or fractional count, or more than six images.",
      "expected": "stop_and_request_an_integer_count_from_one_through_six_without_split_submission",
      "forbiddenTools": ["additional_generation_submission", "automatic_resubmission"]
    },
    {
      "id": "direct-cloud-image-delivery",
      "when": "A Direct Cloud image request must send async: true and the response returns data[].b64_json, data[].url, or an asynchronous task.",
      "expected": "force_async_true_and_write_actual_image_bytes_before_reporting_success",
      "forbiddenTools": ["upstream_url_as_delivery", "automatic_resubmission"]
    },
    {
      "id": "direct-cloud-multiple-image-content",
      "when": "A completed Direct Cloud image task declares more than one content_urls entry.",
      "expected": "retrieve_zero_based_content_indexes_in_declared_order",
      "forbiddenTools": ["upstream_url_as_delivery", "additional_generation_submission", "automatic_resubmission"]
    },
    {
      "id": "ambiguous-model",
      "when": "The requested display name, alias, provider, or media type matches more than one catalog model.",
      "firstTool": "puretokens_list_media_models",
      "expected": "ask_user_to_choose",
      "forbiddenTools": ["puretokens_generate_image", "puretokens_generate_video"]
    },
    {
      "id": "no-media-model",
      "when": "The catalog is empty or has no model with the requested capability.",
      "firstTool": "puretokens_list_media_models",
      "expected": "report_no_available_model",
      "forbiddenTools": ["puretokens_generate_image", "puretokens_generate_video"]
    },
    {
      "id": "new-live-catalog-model",
      "when": "The authenticated catalog contains a newly added exact model ID or display name that is not present in the Skill's registered alias table.",
      "firstTool": "puretokens_list_media_models_or_GET /v1/media/models",
      "expected": "use_the_exact_catalog_model_with_its_declared_capability_without_waiting_for_a_skill_release",
      "forbiddenTools": ["alias_table_as_model_whitelist", "automatic_model_switch"]
    },
    {
      "id": "direct-cloud-no-media-model",
      "when": "The authenticated Direct Cloud catalog is empty or lacks the requested model or capability.",
      "firstTool": "GET /v1/media/models",
      "expected": "report_api_key_catalog_scope_without_desktop_group_instructions",
      "forbiddenTools": ["desktop_group_configuration", "automatic_model_switch", "automatic_resubmission"]
    },
    {
      "id": "direct-cloud-missing-delivery-capability",
      "when": "The host can send HTTPS requests but cannot deliver downloaded bytes as a local file.",
      "expected": "report_missing_delivery_capability_without_submission",
      "forbiddenTools": ["puretokens_generate_image", "puretokens_generate_video", "automatic_resubmission"]
    },
    {
      "id": "skill-defined-image2-api",
      "when": "A Codex or CC Switch user with an active Pure Tokens connection asks for a default image or explicitly selects gpt-image-2/image2, including when no active system, developer, or AGENTS instruction declares an Images API.",
      "expected": "call_the_puretokens_connection_images_api_once_at_the_puretokens_user_endpoint_with_gpt_image_2_without_mcp_or_direct_cloud_fallback",
      "forbiddenTools": ["puretokens_list_media_models", "puretokens_generate_image", "puretokens_image_result", "direct_cloud_submission", "automatic_resubmission"]
    },
    {
      "id": "skill-defined-connection-image-api",
      "when": "A Codex or CC Switch host explicitly provides the active Pure Tokens connection as a callable authenticated HTTPS Images API executor with native-image byte delivery, and the user explicitly selects a non-gpt-image-2 image model.",
      "expected": "read_the_active_connection_catalog_then_submit_one_exact_image_model_to_the_puretokens_user_images_endpoint_and_deliver_the_native_image_without_mcp_or_direct_cloud",
      "forbiddenTools": ["puretokens_generate_image", "puretokens_image_result", "direct_cloud_submission", "automatic_model_switch", "automatic_resubmission"]
    },
    {
      "id": "connection-image-api-not-executable",
      "when": "A Codex or CC Switch chat connection has a configured API key or can read a catalog but the host does not prove callable authenticated HTTPS Images API execution and native-image delivery for an explicitly selected non-gpt-image-2 image model.",
      "expected": "before_any_fallback_submission_tell_the_user_that_the_connection_cannot_directly_execute_the_exact_model_then_use_only_a_verified_same_model_native_executor_mcp_or_direct_cloud_path_or_stop",
      "forbiddenTools": ["unverified_connection_image_submission", "silent_fallback", "automatic_model_switch", "credential_extraction", "automatic_resubmission"]
    },
    {
      "id": "skill-defined-connection-video-api",
      "when": "A Codex or CC Switch host explicitly provides the active Pure Tokens connection as a callable authenticated HTTPS video executor with real byte-delivery capability, and the user asks for a video.",
      "expected": "read_the_active_connection_catalog_then_submit_one_exact_video_model_to_the_puretokens_user_videos_endpoint_and_retrieve_the_same_task_content_without_mcp_or_direct_cloud",
      "forbiddenTools": ["puretokens_generate_video", "puretokens_video_result", "direct_cloud_submission", "automatic_resubmission"]
    },
    {
      "id": "connection-video-api-not-executable",
      "when": "A Codex or CC Switch chat connection has a configured API key but the host does not prove callable authenticated HTTPS video execution and actual byte delivery.",
      "expected": "before_any_fallback_submission_tell_the_user_that_the_connection_cannot_directly_execute_the_exact_video_model_then_use_only_a_verified_same_model_native_executor_mcp_or_direct_cloud_path_or_stop",
      "forbiddenTools": ["unverified_connection_video_submission", "silent_fallback", "automatic_model_switch", "credential_extraction", "automatic_resubmission"]
    },
    {
      "id": "non-puretokens-provider",
      "when": "The selected or available API, MCP server, native media executor, or Direct Cloud credential is explicitly not owned by Pure Tokens, or its Pure Tokens ownership cannot be verified.",
      "expected": "stop_without_submitting_and_tell_the_user_that_this_skill_supports_only_pure_tokens_with_https_puretokensx_com",
      "forbiddenTools": ["third_party_media_submission", "credential_extraction", "provider_conversion", "automatic_resubmission"]
    },
    {
      "id": "physical-image-size-not-supported",
      "when": "The user requests an image physical size such as 200cm x 230cm, 2m x 3m, 20in x 30in, or 500mm x 700mm.",
      "expected": "do_not_treat_the_values_as_n_or_pass_the_physical_unit_to_size; report_the_exact_supported_pixel_canvases_1024x1024_1536x1024_1024x1536_and_optional_1K_2K_4K_resolution",
      "forbiddenTools": ["physical_size_as_image_count", "physical_size_as_size_parameter", "automatic_dpi_conversion", "nearest_size_selection", "automatic_resubmission"]
    },
    {
      "id": "unsupported-image-canvas-or-resolution",
      "when": "The user requests an unsupported pixel canvas such as 1080x1920 or an image_size other than 1K, 2K, or 4K.",
      "expected": "stop_and_list_supported_image_canvases_and_image_size_options_without_nearest_match",
      "forbiddenTools": ["unsupported_size_submission", "nearest_size_selection", "automatic_resubmission"]
    },
    {
      "id": "media-editing-not-supported",
      "when": "The user asks to edit a reference image or video, remove an object, redraw an uploaded asset, or otherwise supply media as editing input.",
      "expected": "explain_text_to_media_only_and_offer_text_prompt_generation_without_accessing_user_media",
      "forbiddenTools": ["media_upload", "media_edit_submission", "pretend_edit_success"]
    },
    {
      "id": "catalog-selection-guidance",
      "when": "The authenticated catalog has multiple matching candidates, lacks the named model, or lacks the requested image/video capability.",
      "expected": "list_exact_candidates_and_give_route_specific_next_steps_without_auto_selection",
      "forbiddenTools": ["automatic_model_switch", "desktop_guidance_for_self_managed_connection"]
    },
    {
      "id": "workbuddy-explicit-host-model",
      "when": "A WorkBuddy user explicitly selects ImageGen, VideoGen, or a manually configured model, including a manually configured Pure Tokens model.",
      "firstTool": "selected_host_native_media_tool",
      "expected": "preserve_explicit_host_model_choice_without_mcp_reroute_or_duplicate_submission",
      "forbiddenTools": ["automatic_model_switch", "puretokens_mcp_override", "duplicate_media_submission"]
    },
    {
      "id": "host-native-model-not-verified-for-media",
      "when": "A manually configured host model is only a general chat model, has no verified image/video capability, or cannot return real media delivery evidence.",
      "expected": "do_not_treat_host_model_configuration_as_media_execution; use_mcp_or_direct_cloud_only_when_available",
      "forbiddenTools": ["unverified_host_native_submission", "automatic_model_switch", "duplicate_media_submission"]
    },
    {
      "id": "mcp-unavailable",
      "when": "The puretokens-image MCP server cannot be listed or called.",
      "firstTool": "puretokens_list_media_models",
      "expected": "use_direct_cloud_when_available_or_report_missing_execution_capability",
      "forbiddenTools": ["puretokens_generate_image", "puretokens_generate_video"]
    },
    {
      "id": "task-failure",
      "when": "A generation or result tool returns an error, including safeToResubmit=false.",
      "firstTool": "selected_generation_or_result_tool",
      "expected": "report_safe_error_and_require_explicit_user_retry_without_fallback_or_resubmit",
      "forbiddenTools": ["automatic_model_switch", "automatic_resubmission"]
    },
    {
      "id": "task-timeout",
      "when": "The matching result tool does not return a native media resource before its polling window ends.",
      "firstTool": "selected_result_tool",
      "expected": "report_pending_or_unknown_and_offer_same_task_check_without_resubmit",
      "forbiddenTools": ["automatic_model_switch", "automatic_resubmission"]
    },
    {
      "id": "content-delivery-failure",
      "when": "A completed task is missing content bytes or local delivery fails.",
      "firstTool": "selected_result_or_content_endpoint",
      "expected": "report_no_delivery_and_offer_same_task_result_check_or_explicit_new_task_without_success_claim",
      "forbiddenTools": ["automatic_model_switch", "automatic_resubmission"]
    }
  ]
}
