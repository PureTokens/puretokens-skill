{
  "schemaVersion": 1,
  "name": "puretokens-connection",
  "version": "0.18.0",
  "entry": "SKILL.md",
  "displayName": "Pure Tokens Connection",
  "description": "Check the fixed Pure Tokens API identity declaration.",
  "executionContract": "references/execution-contract.json",
  "behaviorScenarios": "references/behavior-scenarios.json",
  "distribution": {
    "codex": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/.agents/skills",
      "requiresPluginFeature": false
    },
    "claudeCode": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/.claude/skills"
    },
    "geminiCli": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/.gemini/skills"
    },
    "workbuddy": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/.workbuddy/skills"
    },
    "grokBuild": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/.grok/skills"
    },
    "opencode": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/.config/opencode/skills"
    },
    "trae": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/.trae/skills"
    },
    "claudeDesktop": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/.claude/skills"
    },
    "dshDesktop": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/Library/Application Support/dsh-desktop/harness/skills"
    },
    "zcode": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/.zcode/skills"
    },
    "kimiCode": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/.kimi-code/skills"
    },
    "qoder": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/.qoder/skills"
    }
  },
  "supportedClients": [
    "claude-code",
    "codex",
    "workbuddy",
    "gemini-cli",
    "grok-build",
    "opencode",
    "trae",
    "claude-desktop",
    "dsh-desktop",
    "zcode",
    "kimi-code",
    "qoder"
  ],
  "rules": {
    "usesFixedPureTokensApiOrigin": true,
    "usesFullApiUrls": true,
    "usesManagedNativeExecutor": true,
    "usesCurrentHostConfiguredCredential": true,
    "resolvesCurrentHostConnectionCredentialInMemoryForFixedRequest": true,
    "doesNotUseNodeRuntime": true,
    "doesNotUseMcp": true,
    "doesNotUseComputerUseOrUiAutomation": true,
    "doesNotInvokeOtherMediaSkillsAsApiFallback": true,
    "neverExposesCredentialsOrHostConfiguration": true,
    "apiDeclaredIdentityCheck": true,
    "identityPath": "/v1",
    "doesNotReadActualBaseUrl": true,
    "doesNotInferIdentityFromModelCatalog": true,
    "neverRetry": true,
    "doesNotUseMcpOrFallbackTransport": true,
    "identityDoesNotVerifyCredentials": true
  },
  "sourceSha256": "4edcbf6c5a3fd47432d0544ba172cc998282a32be6e275b74cdd254e769f0cb6"
