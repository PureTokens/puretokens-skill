  "rules": {
    "usesFixedPureTokensApiOrigin": true,
    "usesFullApiUrls": true,
    "usesManagedNativeExecutor": true,
    "usesCurrentHostConfiguredCredential": true,
    "resolvesCurrentHostConnectionCredentialInMemoryForFixedRequest": true,
    "doesNotUseNodeRuntime": true,
    "doesNotUseMcp": true,
    "doesNotUseComputerUseOrUiAutomation": true,
    "doesNotInvokeOtherMediaSkillsAsApiFallback": true,
    "neverExposesCredentialsOrHostConfiguration": true,
    "defaultModel": "gpt-image-2",
    "imagesAlwaysAsync": true,
    "normalSubmissionUsesSelectedProfileAndIndexWhenNeeded": true,
    "usesLazyModelProfileLoading": true,
    "loadsBehaviorScenariosOnDemandOnly": true,
    "exactModelCoreSubmissionDoesNotRequireCatalogPreflight": true,
    "optionalParametersUseInstalledOrOnDemandProfile": true,
    "liveCatalogOnDemandOnly": true,
    "aliasSelectionRequiresUniqueMatch": true,
    "physicalImageDimensionsFailClosed": true,
    "profiledPublicUrlReferenceSupported": true,
    "profiledImageEditSupported": true,
    "nativeVisualReferencesUseProfiledImageEdit": true,
    "enforcesProfiledSizeExpressionConstraints": true,
    "profiledPublicUrlJsonImageEditSupported": true,
    "untransportableNativeReferenceAttachmentsFailClosed": true,
    "neverConvertsUntransportableAttachmentsToPrompt": true,
    "currentRequestScopeOnly": true,
    "endsAfterConfirmedMediaDelivery": true,
    "usesIntentAwarePromptPreparation": true,
    "doesNotSplitDistinctImageAssets": true,
    "usesSafeStructuredFailureReceipts": true,
    "neverAutoResubmitAfterError": true,
    "neverAutoSwitchModelAfterError": true,
    "successRequiresNativeMediaResult": true,
    "multiImageContentIndexesAreZeroBased": true,
    "usesTaskReceipt": true,
    "usesBoundedSameTaskPolling": true,
    "recognizesReconciliationRequired": true,
    "honorsStatusRetryAfterForSameTask": true,
    "reportsOnlyExplicitPublicApiErrorCodes": true,
    "usesResourceBoundedPolling": true,
    "doesNotCreateBackgroundMediaWork": true,
    "usesSequentialNativeContentDelivery": true,
    "doesNotUseMcpOrFallbackTransport": true,
    "supportsExplicitValidationWithoutSubmission": true,
    "supportsOptionalContinuationRecord": true,
    "userReceiptIsConcise": true
  },
