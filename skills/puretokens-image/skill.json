      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/.claude/skills"
    },
    "dshDesktop": {
      "manualInstallationSupported": true,
      "globalSkillDirectory": "~/Library/Application Support/dsh-desktop/harness/skills"
