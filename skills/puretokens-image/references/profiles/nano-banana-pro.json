{
  "$schema": "https://puretokensx.com/schemas/model-profile.schema.json",
  "schemaVersion": 1,
  "capability": "image",
  "catalogUpdatedAt": "2026-09-03",
  "catalogCapturedAt": "2026-09-03T04:00:37.535Z",
  "id": "nano-banana-pro",
  "parameterSchema": {
    "properties": {
      "n": {
        "type": "integer",
        "enum": [
          1
        ],
        "default": 1
      },
      "image_size": {
        "type": "string",
        "enum": [
          "1K",
          "2K",
          "4K"
        ],
        "default": "1K"
      },
      "image": {
        "type": "string[]",
        "maxLength": 6
      },
      "aspect_ratio": {
        "type": "string",
        "enum": [
          "1:1",
          "2:3",
          "3:2",
          "3:4",
          "4:3",
          "9:16",
          "16:9",
          "21:9",
          "9:21"
        ]
      }
    },
    "constraints": {
      "reference_transport": {
        "image": [
          "public_https_url"
        ]
      }
    },
    "lifecycle": {
      "create": {
        "successStatus": 200,
        "idField": "id",
        "object": "image",
        "initialStatuses": [
          "pending"
        ]
      },
      "poll": {
        "method": "GET",
        "path": "/v1/images/{image_id}",
        "intervalSeconds": 3,
        "statusField": "status",
        "pendingStatuses": [
          "pending"
        ],
        "successStatuses": [
          "completed"
        ],
        "failureStatuses": [
          "failed"
        ],
        "resultFields": [
          "content_url",
          "content_urls"
        ]
      }
    },
    "operations": {
      "image_edit": {
        "request": {
          "method": "POST",
          "path": "/v1/images/edits",
          "contentType": "multipart/form-data"
        },
        "requiredBodyFields": [
          "model",
          "prompt",
          "image"
        ],
        "inputs": {
          "image": {
            "field": "image",
            "required": true,
            "minItems": 1,
            "maxItems": 6,
            "transports": [
              "multipart_file"
            ]
          }
        }
      }
    }
  }
}
