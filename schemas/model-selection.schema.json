{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puretokensx.com/schemas/model-selection.schema.json",
  "title": "Pure Tokens installed media model selection",
  "type": "object",
  "required": ["schemaVersion", "capability", "catalogUpdatedAt", "catalogCapturedAt", "models"],
  "properties": {
    "$schema": { "const": "https://puretokensx.com/schemas/model-selection.schema.json" },
    "schemaVersion": { "const": 1 },
    "capability": { "enum": ["image", "video"] },
    "catalogUpdatedAt": { "type": "string", "minLength": 1 },
    "catalogCapturedAt": { "type": "string", "format": "date-time" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "aliases"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "parameterSchema": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
