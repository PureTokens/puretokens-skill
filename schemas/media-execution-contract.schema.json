{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puretokensx.com/schemas/media-execution-contract.schema.json",
  "title": "Pure Tokens specialist direct API execution contract",
  "type": "object",
  "required": ["schemaVersion", "kind", "transport", "result"],
  "properties": {
    "$schema": { "const": "https://puretokensx.com/schemas/media-execution-contract.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "enum": ["balance", "connection", "models", "image", "video", "update"] },
    "transport": { "oneOf": [{ "$ref": "#/$defs/directTransport" }, { "$ref": "#/$defs/updateTransport" }] },
    "operations": {
      "type": "object",
      "properties": {
        "catalog": { "$ref": "#/$defs/request" },
        "submit": { "$ref": "#/$defs/request" },
        "edit": { "$ref": "#/$defs/request" },
        "status": { "$ref": "#/$defs/request" },
        "content": { "$ref": "#/$defs/request" },
        "identity": { "$ref": "#/$defs/request" },
        "read": { "$ref": "#/$defs/request" },
        "sync": { "$ref": "#/$defs/syncOperation" }
      },
      "additionalProperties": false
    },
    "result": { "type": "object", "minProperties": 1, "additionalProperties": true },
    "unsupportedInput": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "parameterValidation": { "type": "object", "additionalProperties": true },
    "inputMediaValidation": { "type": "object", "additionalProperties": true },
    "contentRetrieval": { "type": "object", "additionalProperties": true },
    "polling": { "type": "object", "additionalProperties": true },
    "taskIdentity": { "type": "object", "additionalProperties": true },
    "taskState": { "type": "object", "additionalProperties": true },
    "submissionFailure": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "connection" } } },
      "then": {
        "required": ["operations"],
        "properties": {
          "operations": {
            "required": ["identity"],
            "properties": { "identity": { "properties": { "method": { "const": "GET" }, "url": { "const": "https://api.puretokensx.com/v1" } } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "models" } } },
      "then": {
        "required": ["operations"],
        "properties": {
          "operations": {
            "required": ["catalog"],
            "properties": { "catalog": { "properties": { "method": { "const": "GET" }, "url": { "const": "https://api.puretokensx.com/v1/media/models" } } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "image" } } },
      "then": {
        "required": ["operations", "unsupportedInput", "parameterValidation", "inputMediaValidation", "contentRetrieval", "polling", "taskIdentity", "taskState", "submissionFailure"],
        "properties": {
          "operations": {
            "required": ["catalog", "submit", "edit", "status", "content"],
            "properties": {
              "catalog": { "properties": { "method": { "const": "GET" }, "url": { "const": "https://api.puretokensx.com/v1/media/models" } } },
              "submit": { "properties": { "method": { "const": "POST" }, "url": { "const": "https://api.puretokensx.com/v1/images/generations" } } },
              "status": { "properties": { "method": { "const": "GET" }, "urlTemplate": { "const": "https://api.puretokensx.com/v1/images/{task_id}" } } },
              "content": { "properties": { "method": { "const": "GET" }, "urlTemplate": { "const": "https://api.puretokensx.com/v1/images/{task_id}/content?index={index}" } } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "video" } } },
      "then": {
        "required": ["operations", "unsupportedInput", "parameterValidation", "inputMediaValidation", "contentRetrieval", "polling", "taskIdentity", "taskState", "submissionFailure"],
        "properties": {
          "operations": {
            "required": ["catalog", "submit", "edit", "status", "content"],
            "properties": {
              "catalog": { "properties": { "method": { "const": "GET" }, "url": { "const": "https://api.puretokensx.com/v1/media/models" } } },
              "submit": { "properties": { "method": { "const": "POST" }, "url": { "const": "https://api.puretokensx.com/v1/videos" } } },
              "edit": { "properties": { "method": { "const": "POST" }, "url": { "const": "https://api.puretokensx.com/v1/videos/edits" } } },
              "status": { "properties": { "method": { "const": "GET" }, "urlTemplate": { "const": "https://api.puretokensx.com/v1/videos/{task_id}" } } },
              "content": { "properties": { "method": { "const": "GET" }, "urlTemplate": { "const": "https://api.puretokensx.com/v1/videos/{task_id}/content" } } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "balance" } } },
      "then": {
        "required": ["operations"],
        "properties": {
          "operations": {
            "required": ["read"],
            "properties": { "read": { "properties": { "method": { "const": "GET" }, "url": { "const": "https://api.puretokensx.com/api/product/desktop/account/balance" } } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "update" } } },
      "then": {
        "required": ["operations"],
        "properties": {
          "operations": {
            "required": ["sync"],
            "properties": {
              "sync": {
                "required": ["commandTemplate", "sourceRepository", "sourceBranch", "validationCommand"],
                "properties": {
                  "commandTemplate": { "const": "node bin/puretokens-skill.js sync --target <installation-root>" },
                  "sourceRepository": { "const": "https://github.com/PureTokens/puretokens-skill.git" },
                  "sourceBranch": { "const": "main" },
                  "validationCommand": { "const": "npm run check" }
                }
              }
            }
          },
          "result": {
            "required": ["installsMissingOfficialSkills", "upgradesOnlyManagedMatchingSkills", "neverOverwritesUnmanagedDirectories", "requiresNewHostConversationAfterSuccess"],
            "properties": {
              "installsMissingOfficialSkills": { "const": true },
              "upgradesOnlyManagedMatchingSkills": { "const": true },
              "neverOverwritesUnmanagedDirectories": { "const": true },
              "requiresNewHostConversationAfterSuccess": { "const": true }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "directTransport": {
      "type": "object",
      "required": ["fixedApiOrigin", "usesFullApiUrls", "usesRuntimeManagedAuthentication", "doesNotReadCredentialsOrHostConfiguration", "doesNotUseMcpOrFallbackTransport"],
      "properties": {
        "fixedApiOrigin": { "const": "https://api.puretokensx.com" },
        "usesFullApiUrls": { "const": true },
        "usesRuntimeManagedAuthentication": { "const": true },
        "doesNotReadCredentialsOrHostConfiguration": { "const": true },
        "doesNotUseMcpOrFallbackTransport": { "const": true },
        "requiresNativeMediaByteDelivery": { "const": true }
      },
      "additionalProperties": false
    },
    "updateTransport": {
      "type": "object",
      "required": ["localSkillManager", "usesOfficialMainBranch", "doesNotReadCredentialsOrHostConfiguration", "doesNotUseMediaApiOrMcp"],
      "properties": {
        "localSkillManager": { "const": true },
        "usesOfficialMainBranch": { "const": true },
        "doesNotReadCredentialsOrHostConfiguration": { "const": true },
        "doesNotUseMediaApiOrMcp": { "const": true }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": { "enum": ["GET", "POST"] },
        "url": { "type": "string", "pattern": "^https://api\\.puretokensx\\.com/" },
        "urlTemplate": { "type": "string", "pattern": "^https://api\\.puretokensx\\.com/" },
        "allowedPaths": { "type": "array", "items": { "type": "string", "pattern": "^/v1/" } },
        "pathSource": { "type": "string" },
        "contentType": { "type": "string", "minLength": 1 },
        "requiredBodyFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "fixedBody": { "type": "object" },
        "conditionalBodyFields": { "type": ["object", "array"] },
        "requiresDeclaredProfileOperation": { "type": "string" },
        "inputSource": { "type": "string" },
        "transport": { "type": "string" },
        "requiresExistingAuthenticatedAccountSession": { "type": "boolean" },
        "responseSchema": { "type": "string" }
      },
      "oneOf": [{ "required": ["url"] }, { "required": ["urlTemplate"] }, { "required": ["allowedPaths"] }],
      "additionalProperties": false
    },
    "syncOperation": {
      "type": "object",
      "required": ["commandTemplate", "sourceRepository", "sourceBranch", "validationCommand"],
      "properties": {
        "commandTemplate": { "const": "node bin/puretokens-skill.js sync --target <installation-root>" },
        "sourceRepository": { "const": "https://github.com/PureTokens/puretokens-skill.git" },
        "sourceBranch": { "const": "main" },
        "validationCommand": { "const": "npm run check" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
