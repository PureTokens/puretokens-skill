{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puretokensx.com/schemas/balance-snapshot.schema.json",
  "title": "Pure Tokens authenticated balance snapshot",
  "type": "object",
  "properties": {
    "reported_limit": {
      "type": "number"
    },
    "reported_usage": {
      "type": "number"
    },
    "reported_remaining": {
      "type": "number"
    },
    "unit": {
      "const": "api_display_unit_unspecified"
    },
    "scope": {
      "const": "api_account_or_key_scope_unspecified"
    },
    "note": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
