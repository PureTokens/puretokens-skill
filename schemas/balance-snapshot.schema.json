{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puretokensx.com/schemas/balance-snapshot.schema.json",
  "title": "Sanitized API-key usage balance in USD, with explicit wallet or Key scope",
  "type": "object",
  "properties": {
    "remaining": {
      "type": "number"
    },
    "used": {
      "type": "number",
      "minimum": 0
    },
    "total": {
      "type": "number"
    },
    "unit": {
      "const": "USD"
    },
    "scope": {
      "enum": [
        "account_wallet",
        "key_allowance"
      ]
    },
    "includes_subscription_quota": {
      "const": false
    }
  },
  "additionalProperties": false,
  "required": [
    "remaining",
    "used",
    "total",
    "unit",
    "scope",
    "includes_subscription_quota"
  ]
}
