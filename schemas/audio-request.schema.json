        },
        "response_format": {
          "enum": [
            "mp3",
            "wav"
          ]
        },
        "output_dir": {
          "type": "string",
          "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)[^\\u0000]+$(?![\\s\\S])"
        },
        "input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
