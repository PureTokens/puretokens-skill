{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puretokensx.com/schemas/audio-artifact-verify-request.schema.json",
  "title": "Local audio artifact proof; never submits",
  "type": "object",
  "required": [
    "artifact"
  ],
  "properties": {
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes",
        "media_type"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)[^\\u0000]+$(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "media_type": {
          "enum": [
            "audio/mpeg",
            "audio/wav"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
