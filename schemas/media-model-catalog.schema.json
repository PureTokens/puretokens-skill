{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puretokensx.com/schemas/media-model-catalog.schema.json",
  "title": "Pure Tokens local media model catalog",
  "type": "object",
  "required": ["data"],
  "properties": {
    "object": {
      "const": "list"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "capabilities"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "object": {
            "const": "model"
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["image", "video"]
            }
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "enum": ["image", "video", "mixed"]
          },
          "input_schema": {
            "type": "object"
          },
          "inputSchema": {
            "type": "object"
          },
          "media_parameters": {
            "type": "object"
          },
          "mediaParameters": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
