{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puretokensx.com/schemas/host-support.schema.json",
  "title": "Pure Tokens specialist Skill host support",
  "type": "object",
  "required": ["schemaVersion", "directApiOrigin", "supported"],
  "properties": {
    "$schema": { "const": "https://puretokensx.com/schemas/host-support.schema.json" },
    "schemaVersion": { "const": 1 },
    "directApiOrigin": { "const": "https://api.puretokensx.com" },
    "supported": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/supportedHost" }
    }
  },
  "$defs": {
    "supportedHost": {
      "type": "object",
      "required": ["id", "delivery", "guidance", "directMediaExecution"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "delivery": { "const": "manual-source" },
        "globalSkillDirectory": { "type": "string", "pattern": "^~/(?:\\.[a-z-]+/)*(?:[a-z-]+/)?skills$" },
        "directMediaExecution": { "enum": ["verified-managed-local-runtime", "manual-credential-setup"] },
        "guidance": { "type": "string", "minLength": 1 },
        "directApiOrigin": { "const": "https://api.puretokensx.com" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
