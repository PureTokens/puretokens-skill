{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puretokensx.com/schemas/model-query.schema.json",
  "title": "Explicit local filter for one authenticated models read",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "image",
        "video"
      ]
    },
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,160}$"
    },
    "operation": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,100}$"
    },
    "parameters": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
