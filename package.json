{
  "name": "puretokens-skill",
  "version": "0.13.23",
  "description": "Installable Pure Tokens skills and skill management tooling.",
  "private": true,
  "type": "module",
  "bin": {
    "puretokens-skill": "./bin/puretokens-skill.js"
  },
  "files": [
    "bin/",
    "schemas/",
    "scripts/",
    "skills/",
    "references/",
    "runtime/",
    ".agents/",
    "assets/",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md"
  ],
  "scripts": {
    "list": "node bin/puretokens-skill.js list",
    "validate": "node scripts/validate-skills.mjs && node scripts/sync-skill-model-selection.mjs --check && node scripts/sync-readme-media-catalog.mjs --check && node scripts/check-install-payload.mjs",
    "release:validate": "npm run validate && node scripts/check-media-catalog-freshness.mjs --max-age-days 7",
    "release:build-install-payload": "sh scripts/build-install-payload.sh",
    "docs:sync-media-models": "node scripts/sync-skill-model-selection.mjs --write && node scripts/sync-readme-media-catalog.mjs --write",
    "docs:sync-media-models-from-base-catalog": "node scripts/sync-media-model-catalog-from-service.mjs --write && npm run docs:sync-media-models",
    "docs:sync-media-models-from-service": "npm run docs:sync-media-models-from-base-catalog",
    "test": "node --test",
    "check": "npm run validate && npm test"
  },
  "engines": {
    "node": ">=20"
  }
}
