{
  "name": "puretokens-skill",
  "version": "0.4.0",
  "description": "Installable Pure Tokens skills and skill management tooling.",
  "private": true,
  "type": "module",
  "bin": {
    "puretokens-skill": "./bin/puretokens-skill.js"
  },
  "files": [
    "bin/",
    "schemas/",
    "scripts/",
    "skills/",
    "plugins/",
    ".agents/",
    "assets/",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md"
  ],
  "scripts": {
    "list": "node bin/puretokens-skill.js list",
    "validate": "node scripts/validate-skills.mjs",
    "test": "node --test",
    "check": "npm run validate && npm test",
    "bundle:claude": "node bin/puretokens-skill.js bundle puretokens_media --format claude-desktop --out dist/puretokens_media-0.4.0.zip --force",
    "render:codex": "node scripts/render-codex-media-plugin.mjs",
    "render:workbuddy": "node scripts/render-workbuddy-media-skill.mjs --out dist/workbuddy/puretokens_workbuddy_router"
  },
  "engines": {
    "node": ">=20"
  }
}
